---
let pathname = Astro.url.pathname;
if (pathname.length > 1 && pathname.endsWith("/")) {
  pathname = pathname.slice(0, -1);
}

const links = [
  { href: "#inicio", label: "Início" },
  { href: "#quem-somos", label: "Quem Somos" },
  { href: "#projetos", label: "Projetos" },
  { href: "#equipe", label: "Equipe" },
  { href: "#contato", label: "Contato" },
];
---

<nav class="sticky top-0 z-40 h-20 w-full px-6 py-5 transition-colors duration-300">
  <div class="rounded-full bg-ink text-paper mx-auto flex h-full max-w-maxw items-center justify-between px-3 py-7 shadow-lg gap-3.5">
    <a href="#inicio" class="flex gap-2 font-display items-center">
      <h2 class="flex items-center justify-center text-ink bg-orange p-1 w-9 h-9 -rotate-6 text-[13px] rounded-[10px]">
        PET
      </h2>
      <h2>Letras</h2>
    </a>
    <div
      id="navLinks"
      class="hidden md:flex gap-6 justify-between items-center text-sm font-bold text-paper-3"
    >
      {links.map((link) => (
        <a
          href={link.href}
          data-section={link.href.slice(1)}
          class="nav-link transition-colors"
        >
          {link.label}
        </a>
      ))}
    </div>
    <div
      id="navLinksMobile"
      data-open="false"
      class="md:hidden fixed inset-x-4 top-21 bg-ink rounded-2xl text-sm font-bold p-2 flex flex-col items-start gap-1 w-fit ml-auto
             -translate-y-[140%] transition-transform duration-200 ease-out
             data-[open=true]:translate-y-0"
    >
      {links.map((link) => (
        <a
          href={link.href}
          data-section={link.href.slice(1)}
          class="nav-link transition-colors px-4 py-3 rounded-xl"
        >
          {link.label}
        </a>
      ))}
    </div>
    <div class="flex items-center">
      <a
        href="#contato"
        class="hidden md:flex bg-yellow text-ink text-[13.5px] font-extrabold px-3.5 py-2 rounded-full"
      >
        Fale com a gente
      </a>
    </div>
    <button
      id="navToggle"
      class="md:hidden flex flex-col gap-1 p-2 hover:cursor-pointer"
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="navLinksMobile"
    >
      <span class="block w-5 h-0.5 bg-paper"></span>
      <span class="block w-5 h-0.5 bg-paper"></span>
      <span class="block w-5 h-0.5 bg-paper"></span>
    </button>
  </div>
</nav>

<script>
  const sections = document.querySelectorAll("main section[id]");
  const links = document.querySelectorAll(".nav-link");

  const setActive = () => {
    let current = sections[0]?.id;
    const pos = window.scrollY + 140;
    sections.forEach((sec) => {
      if (pos >= (sec as HTMLElement).offsetTop) current = sec.id;
    });
    links.forEach((l) => {
      const isActive = l.getAttribute("data-section") === current;
      l.classList.toggle("text-ink", isActive);
      l.classList.toggle("bg-yellow", isActive);
      l.classList.toggle("px-3", isActive);
      l.classList.toggle("py-2", isActive);
      l.classList.toggle("rounded-full", isActive);
      l.classList.toggle("hover:text-paper", !isActive);
    });
  };

  document.addEventListener("scroll", setActive, { passive: true });
  setActive();
</script>
<script>
  const toggle = document.getElementById("navToggle");
  const mobileMenu = document.getElementById("navLinksMobile");

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("data-open") === "true";
    toggle.setAttribute("data-open", String(!isOpen));
    mobileMenu?.setAttribute("data-open", String(!isOpen));
    toggle.setAttribute("aria-expanded", String(!isOpen));
  });

  mobileMenu?.querySelectorAll(".nav-link").forEach((link) => {
    link.addEventListener("click", () => {
      toggle?.setAttribute("data-open", "false");
      mobileMenu.setAttribute("data-open", "false");
      toggle?.setAttribute("aria-expanded", "false");
    });
  });
</script>

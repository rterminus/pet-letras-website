---
interface Projeto {
  titulo: string;
  desc: string;
  tag: string;
  estilo: string;
  destaque?: boolean;
  sticker?: boolean;
}

const projetos: Projeto[] = [
  {
    titulo: "Educação Antirracista",
    tag: "CARRO-CHEFE",
    desc: "Ciclo de formações e oficinas voltado a práticas antirracistas na escola pública, com encontros mensais, leituras e produção de materiais didáticos para uso em sala de aula.",
    estilo: "bg-maroon text-paper sm:col-span-2 lg:col-span-12",
    destaque: true,
  },
  {
    titulo: "Vozes Negras nas Letras",
    tag: "LEITURA",
    desc: "Rodas de leitura sobre autoras e autores negros da literatura brasileira e mundial.",
    estilo: "bg-paper-2 text-ink lg:col-span-5",
  },
  {
    titulo: "Rede PET em Diálogo",
    tag: "EXTENSÃO",
    desc: "Palestras abertas com convidadas e convidados externos.",
    estilo: "bg-orange text-paper lg:col-span-3",
    sticker: true,
  },
  {
    titulo: "Letras na Escola",
    tag: "ESCOLA",
    desc: "Oficinas de leitura e escrita em escolas públicas de Natal.",
    estilo: "bg-terracotta text-paper lg:col-span-4",
  },
  {
    titulo: "Pesquisa em Grupo",
    tag: "PESQUISA",
    desc: "Projetos de iniciação científica orientados coletivamente pelo grupo.",
    estilo: "bg-purple text-paper lg:col-span-7",
  },
  {
    titulo: "Produção & Divulgação",
    tag: "MÍDIA",
    desc: "Cards, podcasts e conteúdo acessível para redes sociais.",
    estilo: "bg-paper-2 text-ink sm:col-span-2 lg:col-span-5",
  },
];
---

<section id="projetos" class="overflow-x-clip py-12 sm:py-[4.5rem]">
  <div class="mx-auto max-w-[75rem] px-6">
    <!-- Cabeçalho da seção -->
    <div class="mb-10 max-w-[40rem]">
      <span class="mb-2.5 inline-block font-mono text-xs font-bold text-orange">
        // projetos
      </span>
      <h2
        class="font-display text-[clamp(1.9rem,3.6vw,2.5rem)] leading-[1.02] text-ink"
      >
        O que a gente faz, na prática
      </h2>
      <p class="mt-3.5 text-base leading-relaxed text-ink-soft">
        Um mural das frentes de trabalho em andamento no grupo.
      </p>
    </div>

    <!-- Mural: 1 coluna no celular, 2 no tablet, 12 no desktop -->
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-12">
      {
        projetos.map((p) => (
          <article
            class:list={[
              "relative rounded-2xl border-[2.5px] border-ink p-6 shadow-[6px_6px_0_rgba(34,20,23,.12)]",
              p.destaque && "flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-6",
              p.estilo,
            ]}
          >
            <span class="absolute -top-2.5 right-4 rotate-3 rounded-[0.3rem] border-[1.5px] border-ink bg-yellow px-2.5 py-1 font-mono text-[0.65rem] font-bold text-ink">
              {p.tag}
            </span>

            {p.destaque && (
              <div class="text-5xl leading-none" aria-hidden="true">
                ✦
              </div>
            )}

            <div>
              <h3
                class:list={[
                  "mb-2 font-extrabold",
                  p.destaque ? "text-2xl" : "text-lg",
                ]}
              >
                {p.titulo}
              </h3>
              <p class="text-[0.94rem] leading-relaxed opacity-85">{p.desc}</p>
            </div>

            {p.sticker && (
              <img
                src="/assets/figura-splash.png"
                alt=""
                class="absolute -right-2.5 -bottom-3.5 w-11 -rotate-[10deg]"
              />
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>
---
interface Projeto {
  titulo: string;
  desc: string;
  tag: string;
  estilo: string;
  destaque?: boolean;
  sticker?: boolean;
}

const projetos: Projeto[] = [
  {
    titulo: "Educação Antirracista",
    tag: "CARRO-CHEFE",
    desc: "Desenvolvimento de ações educativas voltadas à promoção da equidade racial, à valorização da diversidade étnico-racial e ao enfrentamento do racismo. Por meio de oficinas, rodas de conversa, debates e atividades de extensão, buscamos contribuir para uma educação crítica, inclusiva e antirracista.",
    estilo: "bg-maroon text-paper sm:col-span-2 lg:col-span-12",
    destaque: true,
  },
  {
    titulo: "Educação Antirracista",
    tag: "LEITURA",
    desc: "Desenvolvimento de ações educativas voltadas à promoção da equidade racial, à valorização da diversidade étnico-racial e ao enfrentamento do racismo. Por meio de oficinas, rodas de conversa, debates e atividades de extensão, buscamos contribuir para uma educação crítica, inclusiva e antirracista.",
    estilo: "bg-paper-2 text-ink text-justify lg:col-span-4",
  },
  {
    titulo: "Educação e Comunidade ",
    tag: "EXTENSÃO",
    desc: "Realização de oficinas, palestras, minicursos e outras atividades educativas destinadas à comunidade do Seridó, promovendo o diálogo entre a universidade e a sociedade e ampliando o acesso ao conhecimento.",
    estilo: "bg-orange text-paper text-justify lg:col-span-4",
    sticker: true,
  },
  {
    titulo: "Letras na Escola",
    tag: "ESCOLA",
    desc: "Desenvolvimento de atividades de extensão em parceria com escolas públicas da região, por meio de oficinas, práticas de leitura e escrita e ações que valorizem a educação, a literatura e a diversidade cultural.",
    estilo: "bg-terracotta text-paper text-justify lg:col-span-4",
  },
  {
    titulo: "Produção & Divulgação",
    tag: "MÍDIA",
    desc: "Produção de publicações para o Instagram e outras redes sociais, divulgando as atividades do PET Letras e compartilhando conteúdos educativos, culturais e informativos sobre literatura, linguagens, educação e questões sociais.",
    estilo: "bg-purple text-paper lg:col-span-12",
  },
];
---

<section id="projetos" class="overflow-x-clip py-12 sm:py-[4.5rem]">
  <div class="mx-auto max-w-[75rem] px-6">
    <!-- Cabeçalho da seção -->
    <div class="mb-10 max-w-[40rem]">
      <span class="mb-2.5 inline-block font-mono text-xs font-bold text-orange">
        // projetos
      </span>
      <h2
        class="font-display text-[clamp(1.9rem,3.6vw,2.5rem)] leading-[1.02] text-ink"
      >
        O que a gente faz, na prática
      </h2>
      <p class="mt-3.5 text-base leading-relaxed text-ink-soft text-justify">
        Conheça as ações e iniciativas desenvolvidas pelo PET Letras, aproximando a
        universidade da comunidade do Seridó por meio da educação, da cultura e da extensão.
      </p>
    </div>

    <!-- Mural: 1 coluna no celular, 2 no tablet, 12 no desktop -->
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-12">
      {
        projetos.map((p) => (
          <article
            class:list={[
              "relative rounded-2xl border-[2.5px] border-ink p-6 shadow-[6px_6px_0_rgba(34,20,23,.12)]",
              p.destaque && "flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-6",
              p.estilo,
            ]}
          >
            <span class="absolute -top-2.5 right-4 rotate-3 rounded-[0.3rem] border-[1.5px] border-ink bg-yellow px-2.5 py-1 font-mono text-[0.65rem] font-bold text-ink">
              {p.tag}
            </span>

            {p.destaque && (
              <div class="text-5xl leading-none" aria-hidden="true">
                ✦
              </div>
            )}

            <div>
              <h3
                class:list={[
                  "mb-2 font-extrabold",
                  p.destaque ? "text-2xl" : "text-lg",
                ]}
              >
                {p.titulo}
              </h3>
              <p class="text-[0.94rem] leading-relaxed opacity-85">{p.desc}</p>
            </div>

            {p.sticker && (
              // <img
              //   src="/assets/figura-splash.png"
              //   alt=""
              //   class="absolute -right-2.5 -bottom-3.5 w-11 -rotate-[10deg]"
              // />
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

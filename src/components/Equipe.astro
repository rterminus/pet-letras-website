---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

import alexandroFoto from "../assets/alexandro.jpeg";
import beatrizFoto from "../assets/beatriz.jpeg";
import eduardoFoto from "../assets/eduardo.jpeg";
import estefanyFoto from "../assets/estefany.jpeg";
import felipeFoto from "../assets/felipe.jpg";
import isisFoto from "../assets/isis.jpeg";
import matheusFoto from "../assets/matheus.jpg";
import patriciaFoto from "../assets/patricia.jpg";
import rayaneFoto from "../assets/rayane.jpg";

interface Membro {
  nome: string;
  papel: string;
  cor: string;
  rot: string;
  foto?: ImageMetadata;
  objectPosition?: string;
  destaque?: boolean;
}

const equipe: Membro[] = [
  {
    nome: "Prof. Dr. Alexandro Teixeira Gomes",
    papel: "Tutor do PET Letras da FELCS",
    cor: "bg-maroon",
    rot: "-rotate-[4deg]",
    foto: alexandroFoto,
    objectPosition: "object-center",
    destaque: true,
  },
  {
    nome: "Beatriz Medeiros",
    papel: "Bolsista PET",
    cor: "bg-orange",
    rot: "rotate-[3deg]",
    foto: beatrizFoto,
    objectPosition: "object-top",
  },
  {
    nome: "Eduardo N.",
    papel: "Bolsista PET",
    cor: "bg-purple",
    rot: "-rotate-[2deg]",
    foto: eduardoFoto,
    objectPosition: "object-top",
  },
  {
    nome: "Estefany M.",
    papel: "Bolsista PET",
    cor: "bg-terracotta",
    rot: "rotate-[5deg]",
    foto: estefanyFoto,
    objectPosition: "object-bottom",
  },
  {
    nome: "L. Felipe",
    papel: "Bolsista PET",
    cor: "bg-maroon",
    rot: "-rotate-[3deg]",
    foto: felipeFoto,
    objectPosition: "object-[center_30%]",
  },
  {
    nome: "Ísis Maria",
    papel: "Bolsista PET",
    cor: "bg-orange",
    rot: "rotate-[2deg]",
    foto: isisFoto,
    objectPosition: "object-center",
  },
  {
    nome: "Matheus Felipe",
    papel: "Bolsista PET",
    cor: "bg-purple",
    rot: "-rotate-[4deg]",
    foto: matheusFoto,
    objectPosition: "object-center",
  },
  {
    nome: "Patrícia Gonçalves",
    papel: "Bolsista PET",
    cor: "bg-terracotta",
    rot: "rotate-[3deg]",
    foto: patriciaFoto,
    objectPosition: "object-top",
  },
  {
    nome: "Rayane Munise",
    papel: "Bolsista PET",
    cor: "bg-maroon",
    rot: "-rotate-[2deg]",
    foto: rayaneFoto,
    objectPosition: "object-bottom",
  },
];

const tutor = equipe.find((m) => m.destaque);
const bolsistas = equipe.filter((m) => !m.destaque);

const iniciais = (nome: string) =>
  nome
    .split(" ")
    .filter(Boolean)
    .map((parte) => parte[0])
    .slice(0, 2)
    .join("")
    .toUpperCase();
---

<section id="equipe" class="overflow-x-clip py-12 bg-ink sm:py-[4.5rem]">
  <div class="mx-auto max-w-[75rem] px-6">
    <!-- Cabeçalho da seção -->
    <div class="mb-10 max-w-[40rem]">
      <span class="mb-2.5 inline-block font-mono text-xs font-bold text-orange">
        // equipe
      </span>
      <h2
        class="font-display text-[clamp(1.9rem,3.6vw,2.5rem)] leading-[1.02] text-paper"
      >
        Vem conhecer nossa equipe
      </h2>
      <p class="mt-3.5 text-base leading-relaxed text-paper/80">
        Tutoria e bolsistas em dedicação conjunta ao PET Letras.
      </p>
    </div>

    <!-- Mural -->
    <div class="overflow-hidden rounded-3xl bg-paper-2 px-4 py-10 sm:px-8 sm:py-11">
      <!-- Tutor em destaque -->
      {
        tutor && (
          <div class="mb-12 flex justify-center">
            <div
              class:list={[
                "relative w-[14.4rem] rounded-xl bg-paper px-5 pt-[1.6rem] pb-5 text-center shadow-[0_13px_22px_rgba(34,20,23,.22)] ring-[3px] ring-orange/70 sm:w-[16rem]",
                "before:absolute before:-top-2 before:left-1/2 before:size-4 before:-translate-x-1/2 before:rounded-full before:bg-orange before:shadow-[0_2px_3px_rgba(0,0,0,.3)]",
                "motion-safe:transition-transform hover:z-10 hover:scale-105",
              ]}
            >
              {tutor.foto ? (
                <Image
                  src={tutor.foto}
                  alt={`Foto de ${tutor.nome}`}
                  width={448}
                  height={448}
                  class:list={[
                    "mx-auto mb-4 size-[9.6rem] rounded-2xl object-cover shadow-md sm:size-[11.2rem]",
                    tutor.objectPosition || "object-center",
                  ]}
                />
              ) : (
                <div
                  aria-hidden="true"
                  class:list={[
                    "mx-auto mb-4 grid size-[9.6rem] place-items-center rounded-2xl font-display text-3xl text-paper sm:size-[11.2rem]",
                    tutor.cor,
                  ]}
                >
                  {iniciais(tutor.nome)}
                </div>
              )}

              <h3 class="text-[0.95rem] font-extrabold leading-tight sm:text-base">
                {tutor.nome}
              </h3>
              <p class="mt-2.5 inline-block rounded-full bg-maroon px-2.5 py-1 font-mono text-[0.65rem] font-bold text-paper sm:text-[0.7rem]">
                {tutor.papel}
              </p>
            </div>
          </div>
        )
      }

      <!-- Bolsistas -->
      <ul class="mx-auto flex max-w-[48.5rem] flex-wrap justify-center gap-4 sm:gap-6">
        {
          bolsistas.map((m) => (
            <li
              class:list={[
                "relative w-[calc(50%-0.5rem)] rounded-[0.625rem] bg-paper px-3 pt-5 pb-4 text-center shadow-[0_10px_18px_rgba(34,20,23,.16)] sm:w-44",
                "before:absolute before:-top-1.5 before:left-1/2 before:size-3.5 before:-translate-x-1/2 before:rounded-full before:bg-orange before:shadow-[0_2px_3px_rgba(0,0,0,.3)]",
                "motion-safe:transition-transform hover:z-10 hover:rotate-0 hover:scale-105",
                m.rot,
              ]}
            >
              {m.foto ? (
                <Image
                  src={m.foto}
                  alt={`Foto de ${m.nome}`}
                  width={224}
                  height={300}
                  class:list={[
                    "mx-auto mb-3 size-28 rounded-xl object-cover shadow-sm",
                    m.objectPosition || "object-center",
                  ]}
                />
              ) : (
                <div
                  aria-hidden="true"
                  class:list={[
                    "mx-auto mb-3 grid size-28 place-items-center rounded-xl font-display text-xl text-paper",
                    m.cor,
                  ]}
                >
                  {iniciais(m.nome)}
                </div>
              )}

              <h3 class="text-sm font-extrabold leading-tight">{m.nome}</h3>
              <p class="mt-1.5 mb-2 font-mono text-[0.65rem] font-bold text-orange">
                {m.papel}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
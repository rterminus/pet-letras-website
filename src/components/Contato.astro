---
interface Contato {
  rotulo: string; // só para leitores de tela
  icone: string; // conteúdo interno do <svg>
  texto: string;
  href?: string;
  externo?: boolean;
}

// Ícones no estilo "linha" (24x24)
const iconeInstagram = `<rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>`;
const iconeEmail = `<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>`;
const iconeLocal = `<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>`;

const contatos: Contato[] = [
  {
    rotulo: "Instagram",
    icone: iconeInstagram,
    texto: "@petletras",
    href: "https://www.instagram.com/petletras/",
    externo: true,
  },
  {
    rotulo: "E-mail",
    icone: iconeEmail,
    texto: "petfelcs@gmail.com",
    href: "mailto:petfelcs@gmail.com",
  },
  {
    rotulo: "Endereço",
    icone: iconeLocal,
    texto:
      "FELCS (Faculdade de Engenharia, Letras e Ciências Sociais do Seridó) - Currais Novos - Rio Grande do Norte",
  },
];
---

<section id="contato" class="overflow-x-clip py-12 sm:py-[4.5rem]">
  <div class="mx-auto max-w-[75rem] px-6">
    <!-- Cartão amarelo -->
    <div
      class="mx-auto max-w-[48rem] rounded-3xl bg-yellow p-6 text-center shadow-[0_16px_30px_rgba(34,20,23,.12)] sm:p-10"
    >
      <!-- Cabeçalho -->
      <div class="mx-auto mb-8 max-w-[40rem]">
        <span class="mb-2.5 inline-block font-mono text-xs font-bold text-maroon">
          // contato
        </span>
        <h2
          class="font-display text-[clamp(1.9rem,3.6vw,2.5rem)] leading-[1.02] text-ink"
        >
          Fale com a gente
        </h2>
        <p class="mt-3.5 text-base leading-relaxed text-ink/80">
          Dúvidas? Siga nosso perfil no insta ou mande um e-mail.
        </p>
      </div>

      <!-- Informações de contato -->
      <ul class="divide-y divide-ink/20 border-y border-ink/20">
        {
          contatos.map((c) => (
            <li class="flex flex-col items-center gap-2.5 py-5">
              <span
                class="grid size-11 place-items-center rounded-full bg-ink text-yellow"
                aria-hidden="true"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="size-5"
                  set:html={c.icone}
                />
              </span>
              <span class="sr-only">{c.rotulo}:</span>
              {c.href ? (
                <a
                  href={c.href}
                  target={c.externo ? "_blank" : undefined}
                  rel={c.externo ? "noopener noreferrer" : undefined}
                  class="min-w-0 font-semibold text-ink underline decoration-ink decoration-2 underline-offset-4 [overflow-wrap:anywhere] transition-colors hover:text-maroon hover:decoration-maroon"
                >
                  {c.texto}
                </a>
              ) : (
                <span class="min-w-0 max-w-[32rem] text-balance font-semibold text-ink [overflow-wrap:anywhere]">
                  {c.texto}
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>